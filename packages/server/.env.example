# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/market_app

# Port for the server to listen on
PORT=5000

# Secret key used for signing JWTs (required; use a long random value)
JWT_SECRET=change-me

# Secret API key the scrapers send in the x-api-key header (required)
SCRAPER_API_KEY=change-me

# Node environment (development, production)
NODE_ENV=development

# Whitelisted Origins for CORS (Required in production)
CLIENT_ORIGIN=https://your-client-app.vercel.app
ADMIN_ORIGIN=https://your-admin-panel.vercel.app

# Admin Credentials for Seeding (Required in production)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Number of reverse-proxy hops in front of the API (e.g. 1 on Render), so rate
# limits use the client IP instead of the proxy IP. Leave empty when not proxied.
TRUST_PROXY=
