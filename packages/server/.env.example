# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/market_app

# Port for the server to listen on
PORT=5000

# Secret key used for signing JWTs
JWT_SECRET=your_jwt_secret_key_here

# Secret API key used for scrapers to authenticate
SCRAPER_API_KEY=your_scraper_secure_api_key_here

# Node environment (development, production)
NODE_ENV=development

# Whitelisted Origins for CORS (Required in production)
CLIENT_ORIGIN=https://your-client-app.vercel.app
ADMIN_ORIGIN=https://your-admin-panel.vercel.app

# Admin Credentials for Seeding (Required in production)
ADMIN_EMAIL=admin@market.com
ADMIN_PASSWORD=your_secure_admin_password_here
